# Dependencies
node_modules/
.pnpm-debug.log*

# Build outputs
dist/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.production

# IDE and OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
*.lcov

# Local reconstruction / Blender tooling
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.blend1
*.blend2

# Runtime and temporary data
pids/
*.pid
*.seed
*.pid.lock
.tmp/
.temp/
.iwsdk/

# MCP configs generated by the CLI
.mcp.json
.cursor/mcp.json
.vscode/mcp.json
.codex/config.toml

# CLI-generated MCP config with machine-specific absolute paths
opencode.json

# ---------------------------------------------------------------------------
# Third-party media (see NOTICE.md). Tesla broadcast footage, frames cut from
# it, and anything generated from those frames is kept locally only.
# Regenerate with references/roadster/tools/extract_reference.py.
# ---------------------------------------------------------------------------
references/roadster/media/
references/roadster/frames/
references/roadster/contact-sheets/
references/roadster/reconstruction/*.mp4
references/roadster/reconstruction/*.jpg
artifacts/thruster-study/
art/roadster/source-inspection/
# AI images generated from video stills, and the Tripo mesh generated from them
art/roadster/reference-images/
art/roadster/tripo/
art/roadster/vfx/*.png
public/textures/vapor-atlas.png
# Earlier car attempts: the Tripo mesh imported as reference, renders of it,
# and .blend files that embed it
art/roadster/model/**/reference/
art/roadster/model-v5/reference/
art/roadster/model/**/*.blend
art/roadster/model-v5/**/*.blend

# ---------------------------------------------------------------------------
# Large generated binaries (renders, captures, recordings). Text reports stay.
# ---------------------------------------------------------------------------
art/**/*.png
art/**/*.jpg
art/**/*.jpeg
art/**/*.webp
art/**/*.glb
art/**/*.npz
art/**/*.npy
art/**/*.blend
!art/roadster/model-v6/roadster_v6.blend
!art/roadster/model-v6/shell.npz
artifacts/**/*.png
artifacts/**/*.jpg
artifacts/**/*.jpeg
artifacts/**/*.webp
artifacts/**/*.glb
artifacts/**/*.mp4
artifacts/**/*.webm
artifacts/**/*.blend
# The film is not published here: its computer-vision segment shows a few seconds of Tesla's
# broadcast. Share it separately (e.g. a release asset) if the owner chooses to.

# Old model review packages and runtime capture logs (images already excluded above): their JSON
# records local machine paths and is not needed to build or run anything.
art/**/review-*/
art/**/runtime-captures/

# Per-machine MCP server config written by the IWSDK CLI (absolute local paths)
.cursor/mcp.json

# Generated film soundtrack (tools/film/soundtrack.py)
artifacts/**/*.wav
