  "required_corrections": [
    {
      "id": "straight_rgba_crossfade_contaminates_cloud_color",
      "severity": "medium",
      "priority": 1,
      "evidence": "Fresh V8 portrait-landing shows thin cyan/blue contour lines around x280\u2013460,y570\u2013590 and dark doubled/ghost top lobes. A magnified crop of this actual image versus V7 makes the regression clear. Landscape landing/descent also show it at smaller size. Actual source vapor has broad colored shading, not thin tracing contours.",
      "regions_px": [
        {
          "image": "portrait-landing.png",
          "bbox": [
            260,
            545,
            480,
            620
          ]
        },
        {
          "image": "landscape-landing.png",
          "bbox": [
            550,
            430,
            810,
            525
          ]
        }
      ],
      "reviewed_source_sha256": "be4270f324f62e34eeea134a9a7cc65feaa4378d97a66031ad05554e5184f492",
      "likely_cause": "The V8 shader directly mixes two straight RGBA atlas samples. RGB stored in transparent regions of one sample leaks into opaque parts of the other sample, creating colored contours and dark halos during evolving crossfade.",
      "fix": "Interpolate premultiplied RGB (sample.rgb * sample.a) and alpha independently; divide mixed RGB by mixed alpha with a small guard before normal straight-alpha framebuffer blending. Keep the mixed alpha and retain current rolling/opacity decay.",
      "verification": "Fresh landing/portrait-landing and dense 10.5\u201313.5s sequence should show no cyan contour or dark ghost silhouette, while retaining cloud shading/occlusion."
    }
  ],
