    {
      "id": "RT-001",
      "priority": "P2",
      "title": "Wheel rolling direction was reversed by the exported root transform",
      "original_location": "src/replay-system.ts:61 (initial reviewed version)",
      "evidence": {
        "wheel_local_axle": [
          1,
          0,
          0
        ],
        "GLB_root_quaternion": [
          0,
          0.7071068286895752,
          0,
          0.7071068286895752
        ],
        "axle_in_car_coordinates": [
          -1.3435883849943764e-07,
          0,
          -0.9999999999999911
        ],
        "original_contact_slip_for_center_velocity_1mps": [
          2.0000001343588565,
          0,
          -1.3435885648505064e-07
        ]
      },
      "reason": "No-slip requires v_center + omega cross r_contact = 0. With forward +X and r_contact=-r*Y, omega must point -Z. The GLB maps wheel local +X to car -Z, so positive local spin is required. Original negative distance/r gave +Z and doubled contact velocity.",
      "repair": "The root agent changed spin to positive distance/r.",
      "verification": "Direct system execution on the actual parsed GLB produced positive local-X wheel delta quaternion [0.1345314555836878,0,0,0.9909093235299252] from t=5 to 5.02. After landing the body quaternion points forward world -X and the path moves world -X, preserving this sign."
    },
    {
      "id": "RT-002",
      "priority": "P2",
      "title": "Drive-away car left the finite ground before replay end",
      "original_location": "src/scene-assets/stage.scene-asset.ts:86 (initial reviewed version)",
      "evidence": {
        "initial_ground_x": [
          -120,
          120
        ],
        "first_root_outside_seconds": 16.5,
        "final_car_root_x": -138.971557
      },
      "repair": "The root agent enlarged the ground to 360 by 180 m.",
      "verification": {
        "current_ground_x": [
          -180,
