        ],
        "final_body_ground_margin_metres": 38.68844300000001,
        "passed": true
      }
    },
    {
      "id": "RT-003",
      "priority": "P2",
      "title": "Particle shader smoothstep used reversed edges",
      "original_location": "src/scene-assets/effects.scene-asset.ts (jet and vapor fragment shaders)",
      "evidence": [
        "smoothstep(1.,.25,r)",
        "smoothstep(1.,.65,d)"
      ],
      "reason": "GLSL defines smoothstep results as undefined when edge0 >= edge1; an inverted fade should invert the result of increasing edges.",
      "primary_source": "https://github.com/KhronosGroup/OpenGL-Refpages/blob/main/gl4/smoothstep.xml",
      "repair": "The root agent replaced both by 1.-smoothstep(low,high,value).",
      "verification": "Reviewed the current source: vapor uses (1.-smoothstep(.25,1.,r)); pressure jets use (1.-smoothstep(.65,1.,d)). GPU execution was outside this offline review."
    },
