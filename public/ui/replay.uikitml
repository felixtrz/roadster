<style>
  .root { width: 124; flex-direction: column; background-color: #07090c; border-color: #262c35; border-width: 0.15; border-radius: 3.2; padding-top: 4.4; padding-bottom: 4.6; padding-left: 5.2; padding-right: 5.2; gap: 2.6; }
  .row { flex-direction: row; align-items: center; justify-content: space-between; gap: 1.8; }
  .brand { flex-direction: row; align-items: center; gap: 1.6; }
  .dot { width: 1.3; height: 1.3; border-radius: 0.65; background-color: #ff2b45; }
  .title { font-size: 5.6; font-weight: 300; color: #ffffff; }
  .subtitle { font-size: 2.5; font-weight: 500; color: #8d97a4; }
  .phase { font-size: 4.4; font-weight: 600; color: #ffffff; }
  .time { font-size: 3.2; color: #9aa4b1; }
  .track { height: 0.7; width: 113.6; border-radius: 0.35; background-color: #1e242c; flex-direction: row; }
  .fill { width: 0; height: 0.7; border-radius: 0.35; background-color: #ff2b45; }
  .button { height: 8.6; min-width: 22; flex-grow: 1; justify-content: center; align-items: center; background-color: #151a21; border-color: #2a313b; border-width: 0.12; border-radius: 2.2; padding-left: 2.6; padding-right: 2.6; cursor: pointer; }
  .primary { background-color: #f4f6f8; border-color: #f4f6f8; }
  .accent { background-color: #ff2b45; border-color: #ff2b45; flex-grow: 0; min-width: 26; }
  .label { font-size: 3.3; font-weight: 600; color: #eef1f4; }
  .dark { color: #07090c; }
  .hint { font-size: 2.4; color: #6f7a87; }
</style>
<div class="root">
  <div class="row">
    <div class="brand"><div class="dot"></div><span class="title">ROADSTER</span></div>
    <span class="subtitle">THE RAMP  /  McGREGOR, TX</span>
  </div>
  <div class="row"><span id="Phase" class="phase">READY</span><span id="Time" class="time">00.0 / 18.0</span></div>
  <div class="track"><div id="Progress" class="fill"></div></div>
  <div class="row">
    <div id="PlayPause" class="button primary"><span id="PlayLabel" class="label dark">Pause</span></div>
    <div id="Restart" class="button"><span class="label">Replay</span></div>
    <div id="SlowMotion" class="button"><span id="SpeedLabel" class="label">1x</span></div>
    <div id="View" class="button"><span id="ViewLabel" class="label">Show view</span></div>
  </div>
  <div class="row"><span class="hint">Climb. Release. Flip. Land in the cloud.</span><div id="EnterXR" class="button accent"><span id="XRLabel" class="label">Enter XR</span></div></div>
</div>
